# -------------------------------------------------------------
# ThinThai Platform Environment Configuration
# -------------------------------------------------------------

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://thinthai:REPLACE_PASSWORD@127.0.0.1:55433/thinthai_dev
TEST_DATABASE_URL=postgresql://thinthai:REPLACE_PASSWORD@127.0.0.1:55433/thinthai_test

# API Server Settings
API_HOST=127.0.0.1
API_PORT=4200
WEB_ORIGIN=http://127.0.0.1:3200
ALLOW_EXTERNAL_ORIGIN=false

# Environment Mode
NODE_ENV=development

# Payment Configuration
# Set ENABLE_SANDBOX_PAYMENTS=true ONLY in development/test with NODE_ENV!=production
ENABLE_SANDBOX_PAYMENTS=true

# Secret for verifying incoming webhooks from payment gateways (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY

# Worker Settings
WORKER_INTERVAL_SECONDS=30

# Production Release Gate (Must be set to true only when verification and security gates pass)
ALLOW_PROD_ROLLOUT=false
