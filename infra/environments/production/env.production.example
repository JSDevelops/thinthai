# -------------------------------------------------------------
# Production Environment Configuration Template
# -------------------------------------------------------------
DATABASE_URL=postgresql://thinthai_prod_user:MANDATORY_HIGH_ENTROPY_PASSWORD@prod-cluster.thinthai.internal:5432/thinthai_prod
API_HOST=0.0.0.0
API_PORT=4200
WEB_ORIGIN=https://thinthai.org
ALLOW_EXTERNAL_ORIGIN=false
NODE_ENV=production
# Sandbox MUST be false in production
ENABLE_SANDBOX_PAYMENTS=false
# Secret for Payment Provider Webhooks (e.g. PromptPay, Omise, GB Prime Pay)
PAYMENT_WEBHOOK_SECRET=MANDATORY_PRODUCTION_WEBHOOK_SECRET_KEY
WORKER_INTERVAL_SECONDS=30
# Gate flag: Set to true only after rehearsal tests and data backups are verified
ALLOW_PROD_ROLLOUT=true
